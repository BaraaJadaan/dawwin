{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dawwin",
  "version": "1.1.0",
  "identifier": "app.dawwin.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Dawwin · Arabic transcription",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 580,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Local Arabic speech-to-text",
    "longDescription": "Transcribes Arabic and English recordings on this computer with Cohere Transcribe Arabic.",
    "publisher": "Baraa Jadaan",
    "homepage": "https://github.com/BaraaJadaan/dawwin",
    "copyright": "© 2026 Baraa Jadaan, MIT License",
    "license": "MIT"
  }
}
